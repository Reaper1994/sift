# Sift configuration. Copy to sift.env (same folder as the sift program) and fill in.
# NEVER commit sift.env — it holds secrets. It's in .gitignore.

# Where the mail lives: m365 (default) or gmail.
SIFT_MAIL_PROVIDER=m365

# ── Microsoft 365 (Entra app registration; see README "Microsoft 365 setup") ──
SIFT_TENANT_ID=
SIFT_CLIENT_ID=
SIFT_CLIENT_SECRET=

# ── Gmail (Google OAuth desktop client; see README "Gmail setup") ──
# Run `sift gmail-login` after filling these in; it saves SIFT_GMAIL_REFRESH_TOKEN here.
SIFT_GMAIL_CLIENT_ID=
SIFT_GMAIL_CLIENT_SECRET=
SIFT_GMAIL_REFRESH_TOKEN=

# Mailboxes THIS PC triages, comma-separated. Gmail: just your one address.
# Running on two PCs? Give each PC a different list so they don't overlap.
SIFT_MAILBOXES=alice@example.com,bob@example.com

# Your organisation's email domain(s) — used to tell internal vs external senders.
# Optional for Gmail: leave empty for a personal account.
SIFT_INTERNAL_DOMAINS=example.com

# Senders whose mail is never sent to the AI (whole domains or exact addresses).
SIFT_EXCLUDE_SENDERS=hr.example.com,legal.example.com

# ── Classifier ──
# jev = TypeSafe Jev (hosted, fast, calibrated confidence)
# ollama = self-hosted model, nothing leaves your network
SIFT_BACKEND=jev

# Jev / TypeSafe — get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
SIFT_JEV_MODEL=jev-latest
# Below this confidence a message is labelled "Sift: Review" instead of guessed.
SIFT_JEV_MIN_CONFIDENCE=0.5
# Redacted email content goes to TypeSafe (US). Set true only once approved
# by your DPO / security team (ideally with an enterprise zero-retention agreement).
SIFT_EXTERNAL_PROCESSING_APPROVED=false

# Ollama (only if SIFT_BACKEND=ollama)
# SIFT_OLLAMA_URL=http://127.0.0.1:11434
# SIFT_OLLAMA_MODEL=llama3.1:8b

# ── Behaviour ──
# true = log what WOULD be labelled, change nothing. Start here.
SIFT_DRY_RUN=true
# How often to check. Empty/0 = run once and exit (for Task Scheduler / cron).
SIFT_POLL_INTERVAL=5m
SIFT_LOOKBACK=24h
SIFT_MAX_PER_RUN=50
SIFT_MAX_BODY_CHARS=3000
SIFT_CONCURRENCY=4
# Flag Urgent / Action Required messages for follow-up (a star in Gmail).
SIFT_FLAG=true
